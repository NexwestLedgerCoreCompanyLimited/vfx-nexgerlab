{
  "name": "vfx-nexgerlab",
  "productName": "VFX NexgerLab",
  "version": "0.2.0",
  "description": "An offline pixel art VFX studio for game developers.",
  "license": "BUSL-1.1",
  "private": true,
  "author": "NEXWEST LEDGER CORE COMPANY LIMITED",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint --ignore-pattern src/engine/pixelfx src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:i18n": "vitest run tests/unit/i18n-parity.test.ts",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && electron-builder",
    "release:check": "node scripts/verify-release.mjs",
    "allowlist": "vitest run --config vitest.scripts.config.ts scripts/build-actor-allowlist",
    "golden": "electron-vite build && UPDATE_GOLDEN=1 playwright test --grep \"golden hashes\""
  },
  "dependencies": {
    "gifuct-js": "2.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-thai": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "i18next": "26.7.1",
    "jsdom": "30.1.3",
    "oxlint": "1.91.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "typescript": "7.0.2",
    "upng-js": "2.1.0",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  }
}
