{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/renderer/src",
    "src/shared",
    "src/engine",
    "src/main/services",
    "src/main/security.ts",
    "tests/unit",
    "tests/helpers/images.ts",
    "tests/helpers/upng-js.d.ts"
  ]
}
